# Copy to .env.local and fill in from Supabase → Settings → API.
# The app works without these; account features are disabled.
# Either the anon key or the sb_publishable_… key; both are public by design.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set to 1 once the custom sign-in email (link + 6-digit code) is pushed;
# that needs your own SMTP, see ../supabase/SETUP.md §4.
VITE_AUTH_EMAIL_CODE=
VITE_SITE_ORIGIN=
VITE_CONTACT_EMAIL=
